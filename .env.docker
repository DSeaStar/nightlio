# Docker Environment Configuration for Nightlio
# Copy this file to .env in the project root to customize your deployment

# Security Settings (CHANGE THESE!)
SECRET_KEY=your-secret-key-change-this-to-something-random-and-secure
JWT_SECRET=your-jwt-secret-change-this-to-something-different-and-secure

# Feature Flags (0=disabled, 1=enabled)
ENABLE_GOOGLE_OAUTH=0
ENABLE_MOOD_MUSIC=0

# Self-host Configuration
DEFAULT_SELF_HOST_ID=selfhost_default_user

# CORS Origins (update for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Google OAuth Settings (only needed if ENABLE_GOOGLE_OAUTH=1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback

# Mood music settings (only needed if ENABLE_MOOD_MUSIC=1)
JAMENDO_CLIENT_ID=

# AI insights (OpenAI-compatible; default SpaceXAI / xAI)
# ENABLE_AI_INSIGHTS=1
# AI_API_KEY=          # or XAI_API_KEY
# AI_BASE_URL=https://api.x.ai/v1
# AI_MODEL=grok-4.5

# Web3 removed

# Database Path (defaults to volume mount in Docker)
# DATABASE_PATH=/app/data/nightlio.db

# Flask Environment
FLASK_ENV=production
RAILWAY_ENVIRONMENT=production

# Port Configuration (usually don't need to change)
# PORT=5000
